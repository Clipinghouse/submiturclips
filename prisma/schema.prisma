// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id                  String   @id @default(uuid())
  creditedName        String
  email               String
  ageGateStatus       Boolean  // Instead of string, true since only adults allowed
  clipLink            String
  description         String?
  selfFilmed          Boolean
  isEdited            Boolean?
  ruleAcknowledgments Boolean
  sourceChannel       String?  // The UTM/source channel tracked from URL
  createdAt           DateTime @default(now())
}
