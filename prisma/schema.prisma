// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id                  String   @id @default(uuid())
  creditedName        String
  email               String
  ageGateStatus       String   // "adult" or "guardian-consented"
  guardianName        String?  // required if under 18
  clipLink            String
  description         String?
  selfFilmed          Boolean
  wantsCredit         Boolean
  ruleAcknowledgments Boolean
  createdAt           DateTime @default(now())
}
